{
  "expo": {
    "name": "Lampy",
    "slug": "lampy-ios",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "lampy",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.lampy.ios",
      "appleTeamId": "B283NY984J",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "Lampy 只在你拍照留下一条生活时使用相机。",
        "NSMicrophoneUsageDescription": "Lampy 只在你录下当时的声音时使用麦克风。",
        "NSPhotoLibraryUsageDescription": "Lampy 只在你从相册选择已有照片留下时读取相册。",
        "NSPhotoLibraryAddUsageDescription": "Lampy 不会把生活写回系统相册；此说明仅用于系统要求。",
        "NSFaceIDUsageDescription": "本机保护开启后，Lampy 在进入或从后台返回时，由系统使用 Face ID 或设备密码认证。Lampy 不获取面部数据。",
        "CFBundleDevelopmentRegion": "en"
      }
    },
    "android": {
      "package": "app.lampy.android",
      "adaptiveIcon": {
        "backgroundColor": "#F3F0E9"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3F0E9",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#F3F0E9",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "本机保护开启后，Lampy 在进入或从后台返回时，由系统使用 Face ID 或设备密码认证。Lampy 不获取面部数据。"
        }
      ],
      "expo-apple-authentication",
      "expo-file-system",
      [
        "expo-image-picker",
        {
          "photosPermission": "Lampy 只在你从相册选择已有照片留下时读取相册。",
          "cameraPermission": "Lampy 只在你拍照留下一条生活时使用相机。"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Lampy 只在你录下当时的声音时使用麦克风。",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "zh-Hans",
              "en"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "locales": {
      "zh-Hans": "./locales/zh-Hans.json",
      "en": "./locales/en.json"
    }
  }
}
