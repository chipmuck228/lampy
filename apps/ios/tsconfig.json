{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["jest"],
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "src/infrastructure/node-sqlite.ts",
    "src/infrastructure/node-media.ts",
    "src/infrastructure/node-media.test.ts",
    "src/infrastructure/sqlite-preservation.test.ts",
    "src/infrastructure/pending-family-sqlite.test.ts",
    "src/family-api/apple-node.ts",
    "src/family-api/listen.ts",
    "src/family-api/node-db.ts",
    "src/family-api/sqlite-repository.test.ts"
  ]
}
