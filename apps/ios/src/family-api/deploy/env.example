# Copy this file to a path outside the repo, e.g. /etc/lampy/family-api.env
# Fill real values there. Never commit the filled file.

LAMPY_FAMILY_API_MODE=production
LAMPY_FAMILY_DATABASE_PATH=/var/lib/lampy/family/family.db
LAMPY_APPLE_CLIENT_ID=app.lampy.ios
LAMPY_FAMILY_API_HOST=127.0.0.1
LAMPY_FAMILY_API_PORT=8787
# Optional. Defaults to <dirname of LAMPY_FAMILY_DATABASE_PATH>/media
# LAMPY_FAMILY_MEDIA_PATH=/var/lib/lampy/family/media

# Must stay unset in production. The process refuses to start if this is present.
# LAMPY_FAMILY_API_TEST_TOKENS=

# iOS client auth target (does not open Recent 家庭 / share /family):
# EXPO_PUBLIC_FAMILY_API_BASE_URL=https://family.example.invalid
# Family product chrome. Keep unset unless a reviewed open is intended:
# EXPO_PUBLIC_FAMILY_ENTRY_OPEN=1

# Email register stays closed until account delete is safe for creators,
# live shares, and media ownership. Do not set this on family.yunpura.com
# from this slice. Memory mailer is refused in production.
# LAMPY_EMAIL_REGISTER_ENABLED=1
# LAMPY_EMAIL_MAILER=smtp
# LAMPY_EMAIL_SMTP_HOST=
# LAMPY_EMAIL_SMTP_PORT=465
# LAMPY_EMAIL_SMTP_USER=
# LAMPY_EMAIL_SMTP_PASS=
# LAMPY_EMAIL_FROM=Lampy <noreply@example.invalid>
