# No Apple keys, passwords or account tokens. Root-owned, mode 0600.
LAMPY_BACKUP_DATABASE=/srv/lampy-family/family.sqlite
LAMPY_BACKUP_MEDIA=/srv/lampy-family/media
# Mount a separate backup volume here; root:root, 0700. Do not snapshot it again.
LAMPY_BACKUP_ROOT=/srv/lampy-backups
LAMPY_RESTORE_CHECK_ROOT=/srv/lampy-backups/.restore-checks
