<view class="light-wall {{gathering ? 'gathering' : ''}}" style="transform: translateY({{lift * -1}}px);">
  <block wx:if="{{empty}}">
    <view class="seed {{instant ? 'is-ready' : ''}} {{awaken ? 'is-awake' : ''}}">
      <light-point
        size="28"
        opacity="0.42"
        color="{{seedColor}}"
        duration="5200"
        delay="-800"
        seed="{{true}}"
        bind:select="onSeed"
      />
      <text class="hint">你的第一盏光，从今天开始。</text>
    </view>
  </block>

  <view
    wx:for="{{dots}}"
    wx:key="id"
    class="light-hit-area {{item.tapped ? 'tapped' : ''}}"
    style="left: {{item.left}}; top: {{item.top}};"
    catchtap="onLightTap"
    data-id="{{item.id}}"
  >
    <view
      class="light-point"
      style="width: {{item.size}}rpx; height: {{item.size}}rpx; opacity: {{item.opacity}}; background: radial-gradient(circle, {{item.color}} 0%, {{item.color}} 40%, transparent 100%); filter: blur({{item.blur}}px); box-shadow: 0 0 {{item.shadowBlur}}rpx {{item.color}}; animation-delay: {{item.animationDelay}}ms;"
    ></view>
  </view>
</view>
