/**
 * 首页与启动层。整页只有夜空底色，组件不再自成色块。
 */
.page {
  position: relative;
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding-left: 48rpx;
  padding-right: 48rpx;
  overflow: hidden;
  background: #0B1026;
}

.is-locked {
  pointer-events: none;
}

.home {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  opacity: 0;
}

.home.is-ready,
.wall-box.is-ready {
  opacity: 1;
}

.home.is-visible {
  animation: homeIn 1000ms ease-out both;
}

.top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 4rpx 16rpx;
}

.date {
  font-size: 28rpx;
  color: #8A93B2;
  letter-spacing: 2rpx;
}

.vault-entry {
  position: absolute;
  top: 80rpx;
  right: 40rpx;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.vault-icon {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #FFD97D;
  opacity: 0.5;
  box-shadow: 0 0 16rpx rgba(255, 217, 125, 0.4);
  transition: all 0.3s ease;
}

.vault-entry.is-pressing .vault-icon {
  opacity: 1;
  transform: scale(1.3);
  box-shadow: 0 0 24rpx rgba(255, 217, 125, 0.8);
}

.row {
  position: relative;
  z-index: 20;
  display: flex;
  align-items: center;
  padding: 32rpx 40rpx;
  background: transparent;
}

.incoming {
  margin-bottom: 4rpx;
}

.nearby {
  margin-top: 8rpx;
}

.row-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #FFD97D;
  box-shadow: 0 0 14rpx 4rpx rgba(255, 217, 125, 0.45);
  flex-shrink: 0;
}

.row-text {
  margin-left: 16rpx;
  flex: 1;
  font-size: 30rpx;
  color: #F5F1E8;
}

.arrow {
  font-size: 36rpx;
  color: #8A93B2;
  line-height: 1;
}

.stage {
  flex: 1;
  height: 0;
  min-height: 0;
  background: transparent;
}

.wall-box {
  position: relative;
  width: 100%;
  height: 68vh;
  min-height: 960rpx;
  background: transparent;
  border-radius: 0;
  box-shadow: none;
  opacity: 0;
}

.wall-box.is-awake {
  animation: wallIn 1000ms ease-out both;
}

.cta {
  position: relative;
  z-index: 20;
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.orb {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  border: none;
  box-shadow: none;
  background: radial-gradient(circle at 50% 50%, #FFE9A8 0%, #FFD97D 40%, rgba(255, 217, 125, 0.3) 70%, rgba(255, 217, 125, 0) 100%);
  animation: orbBreathe 6000ms ease-in-out infinite;
}

.cta-label {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #8A93B2;
  letter-spacing: 2rpx;
}

.splash {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 99;
  background: #0B1026;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  pointer-events: auto;
}

.splash-dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #FFD97D;
  box-shadow: 0 0 36rpx 10rpx rgba(255, 217, 125, 0.42);
  opacity: 0;
  transform: scale(0.6);
  animation: splashGlow 1200ms ease-out both;
}

.splash-name {
  margin-top: 36rpx;
  font-size: 28rpx;
  letter-spacing: 8rpx;
  color: #F5F1E8;
  opacity: 0;
  animation: splashName 800ms ease-out 400ms both;
}

.is-grow .splash-dot {
  animation: splashGrow 300ms ease-out both;
}

.is-leaving {
  animation: splashOut 500ms ease-in both;
}

.is-hidden {
  display: none;
}

.is-pressing {
  opacity: 0.78;
}

@keyframes splashGlow {
  from {
    opacity: 0;
    transform: scale(0.6);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes splashName {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes splashGrow {
  from { transform: scale(1); opacity: 1; }
  to { transform: scale(1.15); opacity: 1; }
}

@keyframes splashOut {
  from { opacity: 1; }
  to { opacity: 0; }
}

@keyframes homeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes wallIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes orbBreathe {
  0%,
  100% {
    transform: scale(1);
    opacity: 0.85;
  }
  50% {
    transform: scale(1.05);
    opacity: 1;
  }
}
