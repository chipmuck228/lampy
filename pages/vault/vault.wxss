page {
  background: #0B1026;
  height: 100vh;
  overflow: hidden;
}

.vault-page {
  width: 100%;
  height: 100vh;
  position: relative;
  background: #0B1026;
}

.vault-header {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  padding: 80rpx 40rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 100;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #F5F1E8;
  font-weight: 200;
}

.vault-title {
  font-size: 28rpx;
  color: #8A93B2;
  letter-spacing: 4rpx;
}

.vault-count {
  font-size: 26rpx;
  color: #8A93B2;
}

.vault-sky {
  position: absolute;
  top: 180rpx;
  bottom: 240rpx;
  left: 0;
  right: 0;
  overflow: hidden;
}

.light-hit-area {
  position: absolute;
  width: 96rpx;
  height: 96rpx;
  margin-left: -48rpx;
  margin-top: -48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  opacity: 0;
  transition: left 0.8s ease, top 0.8s ease, opacity 0.8s ease;
}

.vault-page:not(.entering) .light-hit-area {
  opacity: 1;
}

.light-point {
  border-radius: 50%;
  animation: breathe 6s ease-in-out infinite;
  pointer-events: none;
  transition: transform 0.3s ease;
}

.view-switcher {
  position: absolute;
  bottom: 140rpx;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  z-index: 100;
}

.view-btn {
  font-size: 28rpx;
  color: #8A93B2;
  padding: 12rpx 24rpx;
  letter-spacing: 4rpx;
  transition: color 0.3s ease, text-shadow 0.3s ease;
}

.view-btn + .view-btn {
  margin-left: 60rpx;
}

.view-btn.active {
  color: #FFD97D;
  text-shadow: 0 0 16rpx rgba(255, 217, 125, 0.6);
}

.vault-caption {
  position: absolute;
  bottom: 80rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 26rpx;
  color: #8A93B2;
  letter-spacing: 2rpx;
}

.is-pressing {
  opacity: 0.78;
}

@keyframes breathe {
  0%,
  100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.08);
  }
}
