<view class="detail-page" style="padding-top: {{headerPad}}px; padding-bottom: {{bottomPad}}px;">
  <view class="detail-header">
    <view class="back-btn" hover-class="is-pressing" bindtap="onBack">‹</view>
  </view>

  <view wx:if="{{status === 'loading'}}" class="state-block">
    <view class="breathing-light"></view>
  </view>

  <view wx:elif="{{status === 'not-found'}}" class="state-block">
    <view class="breathing-light is-dim"></view>
    <text class="state-text">这盏光暂时找不到了</text>
    <view class="state-action" hover-class="is-pressing" bindtap="onBack">返回</view>
  </view>

  <view wx:elif="{{status === 'error'}}" class="state-block">
    <view class="breathing-light is-dim"></view>
    <text class="state-text">暂时无法打开这盏光</text>
    <view class="state-action" hover-class="is-pressing" bindtap="onBack">返回</view>
  </view>

  <view wx:elif="{{status === 'ready' && detail}}" class="ready">
    <view class="breathing-light"></view>

    <text class="date-label">{{detail.displayDate.primary}}</text>
    <text class="source-label">{{detail.source.label}}</text>

    <text wx:if="{{detail.state.hasText}}" class="note">{{detail.content.note}}</text>
    <text wx:if="{{detail.content.significance}}" class="significance">{{detail.content.significance}}</text>

    <view
      wx:for="{{detail.assets}}"
      wx:key="id"
      class="asset-block"
    >
      <block wx:if="{{item.type === 'image'}}">
        <image
          wx:if="{{item.status === 'available'}}"
          class="photo"
          src="{{item.localUri}}"
          mode="widthFix"
          data-id="{{item.id}}"
          bindtap="onImageTap"
          binderror="onImageError"
        />
        <text wx:else class="asset-fallback">这张照片暂时无法显示</text>
      </block>

      <block wx:elif="{{item.type === 'audio'}}">
        <view wx:if="{{item.status === 'available'}}" class="audio-card">
          <text class="audio-hint">听听当时的声音</text>
          <text wx:if="{{item.display.durationLabel}}" class="audio-duration">{{item.display.durationLabel}}</text>
          <view
            class="audio-action"
            hover-class="is-pressing"
            data-id="{{item.id}}"
            bindtap="onAudioTap"
          >{{audio.playingAssetId === item.id && audio.isPlaying ? '暂停' : '播放'}}</view>
        </view>
        <text wx:else class="asset-fallback">声音暂时无法播放</text>
      </block>

      <text wx:elif="{{item.type === 'video'}}" class="asset-fallback">暂不支持播放</text>
    </view>

    <text wx:if="{{detail.content.emotion}}" class="emotion">{{detail.content.emotion}}</text>
  </view>
</view>
