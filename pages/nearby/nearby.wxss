page {
  background: #0B1026;
  height: 100vh;
  overflow: hidden;
}

.nearby-page {
  width: 100%;
  height: 100vh;
  background: #0B1026;
  display: flex;
  flex-direction: column;
  position: relative;
}

.nearby-header {
  padding: 80rpx 40rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 100;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #F5F1E8;
  font-weight: 200;
}

.nearby-title {
  font-size: 28rpx;
  color: #8A93B2;
  letter-spacing: 4rpx;
}

.placeholder {
  width: 60rpx;
}

.nearby-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
}

.current-light {
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: opacity 0.4s ease;
  width: 100%;
}

.light-point-large {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: radial-gradient(
    circle at 50% 50%,
    #FFE9A8 0%,
    #FFD97D 30%,
    rgba(255, 217, 125, 0.4) 60%,
    rgba(255, 217, 125, 0) 100%
  );
  animation: breathe 6s ease-in-out infinite;
  margin-bottom: 60rpx;
}

.light-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
  min-height: 200rpx;
}

.light-text {
  font-size: 36rpx;
  color: #F5F1E8;
  line-height: 1.8;
  text-align: center;
  letter-spacing: 2rpx;
  margin-bottom: 20rpx;
}

.light-emotion {
  font-size: 24rpx;
  color: #8A93B2;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(138, 147, 178, 0.1);
  letter-spacing: 2rpx;
}

.light-actions {
  display: flex;
  margin-top: 40rpx;
}

.action-btn {
  padding: 20rpx 60rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
  color: #F5F1E8;
  background: rgba(255, 217, 125, 0.08);
  border: 1rpx solid rgba(255, 217, 125, 0.3);
  letter-spacing: 4rpx;
  transition: background 0.3s ease, border-color 0.3s ease, transform 0.3s ease;
}

.action-btn + .action-btn {
  margin-left: 40rpx;
}

.action-btn.is-pressing {
  background: rgba(255, 217, 125, 0.2);
  border-color: rgba(255, 217, 125, 0.6);
  transform: scale(0.96);
}

.progress-dots {
  position: absolute;
  bottom: 120rpx;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #8A93B2;
  opacity: 0.3;
  transition: background 0.4s ease, opacity 0.4s ease, transform 0.4s ease;
}

.dot + .dot {
  margin-left: 16rpx;
}

.dot.active {
  background: #FFD97D;
  opacity: 1;
  box-shadow: 0 0 12rpx rgba(255, 217, 125, 0.8);
  transform: scale(1.3);
}

.dot.done {
  background: #8A93B2;
  opacity: 0.5;
}

.nearby-finished {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
}

.finished-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #FFD97D;
  opacity: 0.6;
  box-shadow: 0 0 24rpx rgba(255, 217, 125, 0.6);
  margin-bottom: 60rpx;
  animation: breathe 6s ease-in-out infinite;
}

.finished-text {
  font-size: 32rpx;
  color: #F5F1E8;
  letter-spacing: 4rpx;
  margin-bottom: 20rpx;
  text-align: center;
}

.finished-sub {
  font-size: 24rpx;
  color: #8A93B2;
  letter-spacing: 2rpx;
}

.is-pressing {
  opacity: 0.78;
}

.action-btn.is-pressing {
  opacity: 1;
}

@keyframes breathe {
  0%,
  100% {
    transform: scale(1);
    opacity: 0.9;
  }
  50% {
    transform: scale(1.08);
    opacity: 1;
  }
}
